# Staging frontend build/runtime example — placeholders only.
# Copy values into the Cloudflare staging Worker / CI secrets.
# Never commit real secrets or production API origins here.

# Required for shared staging builds and deploy:cf:staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_DEPLOYMENT_ENV=staging
NEXT_PUBLIC_API_BASE=https://api-staging.metioro.com

# Optional release metadata (set by CI)
# NEXT_PUBLIC_RELEASE_SHA=<git-sha>

# Temporary exception only (default unset/false). Do not enable for normal staging.
# ALLOW_STAGING_TO_PRODUCTION_API=1

# Never set OpenAI or Railway secrets in NEXT_PUBLIC_* variables.

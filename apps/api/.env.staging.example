# Staging API environment example — placeholders only.
# Set these on the Railway staging service/environment.
# Never commit real secret values.

APP_ENV=staging

# Conversation generation (staging should normally use openai for Ask smoke)
CONVERSATION_GENERATION_PROVIDER=openai
OPENAI_API_KEY=<set-in-railway-staging-secret>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25.0

# Comma-separated staging frontend origins only (no wildcard)
# Include workers.dev staging URL until custom DNS is ready.
CORS_ALLOWED_ORIGINS=https://staging.metioro.com,https://planet-life-web-staging.<account>.workers.dev

# Optional local API development against staging FE is not required here.
# Do not copy production database credentials unless explicitly approved.

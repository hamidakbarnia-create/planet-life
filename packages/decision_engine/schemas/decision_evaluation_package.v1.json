{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metioro.com/schemas/decision_evaluation_package.v1.json",
  "title": "DecisionEvaluationPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "evaluation_id",
    "evaluation_version",
    "case_version",
    "decision_type_id",
    "family_id",
    "mode",
    "precision_level",
    "engine_id",
    "created_at",
    "schema_version",
    "recommendation",
    "timing",
    "confidence",
    "evidence",
    "drivers",
    "tradeoffs",
    "risks",
    "opportunities",
    "action_plan",
    "counter_recommendation",
    "explainability",
    "improve_accuracy",
    "next_decisions",
    "related_decisions"
  ],
  "properties": {
    "case_id": { "type": "string", "format": "uuid" },
    "evaluation_id": { "type": "string", "format": "uuid" },
    "evaluation_version": { "type": "integer", "minimum": 1 },
    "case_version": { "type": "integer", "minimum": 1 },
    "decision_type_id": { "type": "string", "minLength": 1 },
    "family_id": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "string",
      "enum": ["evaluate_date", "compare_dates", "find_dates"]
    },
    "precision_level": {
      "$ref": "#/$defs/precisionLevel"
    },
    "engine_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "schema_version": { "const": "1.0.0" },

    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stance", "conditions", "summary"],
      "properties": {
        "stance": { "$ref": "#/$defs/stance" },
        "conditions": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string" }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },

    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material", "band", "score", "candidates", "notes"],
      "properties": {
        "material": { "type": "boolean" },
        "band": {
          "type": "string",
          "enum": ["high", "moderate", "low", "na"]
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "candidates": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/timingCandidate" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "material": { "const": false } },
            "required": ["material"]
          },
          "then": {
            "properties": {
              "band": { "const": "na" },
              "score": { "type": "null" }
            }
          }
        }
      ]
    },

    "find": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range_start",
        "range_end",
        "timezone",
        "windows",
        "unique_dominant"
      ],
      "properties": {
        "range_start": { "type": "string", "format": "date" },
        "range_end": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "minLength": 1 },
        "windows": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/findWindow" }
        },
        "unique_dominant": { "type": "boolean" }
      }
    },

    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision_level", "penalties"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "precision_level": {
          "$ref": "#/$defs/precisionLevel"
        },
        "penalties": {
          "type": "array",
          "items": { "$ref": "#/$defs/confidencePenalty" }
        }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceItem" }
        }
      }
    },

    "drivers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/driverItem" }
        }
      }
    },

    "tradeoffs": { "$ref": "#/$defs/limitedStringItems" },
    "risks": { "$ref": "#/$defs/limitedStringItems" },
    "opportunities": { "$ref": "#/$defs/limitedStringItems" },

    "action_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/actionStep" }
        }
      }
    },

    "counter_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stance", "summary", "reason"],
      "properties": {
        "stance": { "$ref": "#/$defs/stance" },
        "summary": { "type": "string" },
        "reason": { "type": "string" }
      }
    },

    "explainability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why", "why_not", "assumptions", "limits"],
      "properties": {
        "why": { "type": "string" },
        "why_not": { "type": "string" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "limits": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "improve_accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string" }
        }
      }
    },

    "next_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/decisionLink" }
        }
      }
    },

    "related_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionLink" }
        }
      }
    },

    "semantic_shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "semantic_status", "assessments"],
      "properties": {
        "schema_version": { "const": "decision_assessment.v1-shadow" },
        "semantic_status": { "const": "experimental_shadow" },
        "assessments": {
          "type": "array",
          "items": { "type": "object" }
        },
        "score_vs_class_disagreements": {
          "type": "array",
          "items": { "type": "object" }
        },
        "find_window_semantic_warnings": {
          "type": "array",
          "items": { "type": "object" }
        },
        "policy": { "type": "object" },
        "policy_pairs": {
          "type": "array",
          "items": { "type": "object" }
        },
        "window_policies": {
          "type": "array",
          "items": { "type": "object" }
        },
        "explanation": { "type": "object" },
        "explanations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "window_explanations": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "evaluate_date" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "timing": {
            "properties": {
              "candidates": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "compare_dates" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "timing": {
            "properties": {
              "candidates": {
                "minItems": 2,
                "maxItems": 5
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "find_dates" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["find"],
        "properties": {
          "timing": {
            "properties": {
              "candidates": {
                "maxItems": 5
              }
            }
          }
        }
      }
    }
  ],

  "$defs": {
    "stance": {
      "type": "string",
      "enum": [
        "proceed",
        "proceed_with_conditions",
        "wait",
        "prefer_alternate",
        "no_unique_winner",
        "insufficient_data"
      ]
    },
    "precisionLevel": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"]
    },
    "timingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "rank", "score", "band"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "rank": { "type": "integer", "minimum": 1 },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "type": "string",
          "enum": ["high", "moderate", "low"]
        },
        "option_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "strengths": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "risks": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        }
      }
    },
    "findWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "start_date",
        "end_date",
        "peak_dates",
        "peak_score",
        "band",
        "rank"
      ],
      "properties": {
        "window_id": { "type": "string", "minLength": 1 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "peak_dates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "format": "date" }
        },
        "peak_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "type": "string",
          "enum": ["high", "moderate", "low"]
        },
        "rank": { "type": "integer", "minimum": 1 },
        "strengths": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "risks": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        }
      }
    },
    "confidencePenalty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_id", "eligibility", "artifact_ref", "limits"],
      "properties": {
        "framework_id": { "type": "string", "minLength": 1 },
        "eligibility": { "type": "string", "minLength": 1 },
        "artifact_ref": { "type": "string", "minLength": 1 },
        "limits": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "driverItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "score", "band", "support", "friction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "contribution": {
          "type": "number",
          "description": "Signed explanatory contribution. Not a 0..100 timing-quality score."
        },
        "polarity": {
          "type": "string",
          "enum": ["supportive", "cautionary", "neutral"],
          "description": "Canonical driver polarity. Prefer over deprecated band."
        },
        "importance": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Explanatory magnitude metadata. Independent of polarity."
        },
        "factor_key": {
          "type": "string",
          "minLength": 1,
          "description": "Optional deterministic semantic key for localization (e.g. aspect.mercury.square.saturn). Not a display string."
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "DEPRECATED compatibility magnitude (abs(contribution) clamped). Not candidate timing score."
        },
        "band": {
          "type": "string",
          "minLength": 1,
          "description": "DEPRECATED compatibility polarity projection (supportive→high, cautionary→low, neutral→moderate). Not score_to_candidate_band."
        },
        "support": { "type": "string" },
        "friction": { "type": "string" }
      }
    },
    "limitedStringItems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        }
      }
    },
    "actionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "action", "condition"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "condition": { "type": ["string", "null"] }
      }
    },
    "decisionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_type_id", "label"],
      "properties": {
        "decision_type_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
